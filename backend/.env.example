PORT=3000
# Passwords with special characters must be URL-encoded.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/sonamaint
TEST_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/sonamaint_test
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
CORS_ORIGIN=http://localhost:5173
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10
NODE_ENV=development
AUTH_MODE=dev
AUTH_JWKS_URL=
AUTH_ISSUER=
AUTH_AUDIENCE=
DEV_USER_ID=dev-user
DEV_USER_NAME=Development User
